/run/initialize
/process/had/rdm/thresholdForVeryLongDecayTime 1.0e+60 year
/gps/particle ion
/gps/ene/mono 0 eV
/gps/ion 2 6 2 0  # Z=2 (He), A=6, Q=2, E=0
/gps/number 1
/gps/pos/type Volume
/gps/pos/shape Cylinder
/gps/pos/radius 5 cm
/gps/pos/halfz 20 cm
/gps/pos/centre 0 0 0 cm
/gps/pos/confine Vacuum
/gps/ang/type iso
/run/beamOn 1000000